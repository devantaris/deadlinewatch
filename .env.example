# ---------------------------------------------------------------------------
# DeadlineWatch configuration. Copy to .env and fill in.
# .env is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Gmail -----------------------------------------------------------------
# Requires 2-Step Verification on your Google account.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (16 chars, keep the spaces or remove them - both work)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Which mailboxes to scan, comma separated. Gmail labels work too, e.g.
# INBOX,College   (find your label names with: python -m src.main folders)
IMAP_FOLDERS=INBOX

# --- Telegram --------------------------------------------------------------
# 1. Open Telegram, talk to @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot
# 3. Run:  python -m src.main test-telegram   (it auto-detects your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (any OpenAI-compatible endpoint) ---------------------------------
# OpenAI:      key=https://api.openai.com/v1  model=gpt-4o-mini
# OpenRouter:  key=https://openrouter.ai/api/v1  model=anthropic/claude-3.5-sonnet
# Groq:        key=https://api.groq.com/openai/v1  model=llama-3.1-8b-instant
# Ollama local: key=ollama  base=http://localhost:11434/v1  model=llama3.1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Max tokens per minute the tool will use. Free tiers (Groq: 8000) will rate
# limit you otherwise, and a rate-limited batch gets retried, not lost.
# Use 0 to disable throttling.
LLM_TPM_LIMIT=6000

# --- Behaviour -------------------------------------------------------------
# Local timezone label used for display only (Windows local time is used for math)
TIMEZONE=Asia/Kolkata
# How often to poll Gmail (minutes)
POLL_INTERVAL_MINUTES=5
# Daily briefing time
DIGEST_HOUR=9
DIGEST_MINUTE=0
# Alert immediately when a deadline is within this many hours
URGENT_WINDOW_HOURS=24
# How many emails to send to the LLM in one request. Lower = cheaper and safer
# on free tiers. If a request comes back too large, the tool splits it in half
# automatically, so this only needs to be roughly right.
EMAILS_PER_BATCH=4
# How many recent emails the very first run looks at (keeps the first run cheap)
SEED_LIMIT=25
# Optional: only consider mail matching these words (comma separated). Empty = use the LLM on everything.
FILTER_KEYWORDS=

# --- Telegram command listener --------------------------------------------
# How often the bot checks for /done, /snooze, /today commands (seconds)
BOT_POLL_SECONDS=5

# --- Local dashboard -------------------------------------------------------
# The dashboard only binds to localhost - never expose it to your network.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
